# Provedor principal (padrão) ou alternativa explícita: watsonx_orchestrate | groq
LLM_PROVIDER=watsonx_orchestrate

# IBM watsonx Orchestrate — não use URL do console; use a URL de serviço da instância.
WATSONX_ORCHESTRATE_SERVICE_URL=https://api.REGION.watson-orchestrate.cloud.ibm.com/instances/INSTANCE_ID
WATSONX_ORCHESTRATE_AGENT_ID=00000000-0000-0000-0000-000000000000
# IBM Cloud: informe a API key para o backend obter/renovar o token IAM.
WATSONX_ORCHESTRATE_API_KEY=replace-with-ibm-cloud-api-key
# Alternativa para outros ambientes ou testes: bearer token temporário (deixe vazio em IBM Cloud).
WATSONX_ORCHESTRATE_ACCESS_TOKEN=
WATSONX_ORCHESTRATE_IAM_URL=https://iam.cloud.ibm.com/identity/token

# Protege /api/tools/*, consumido pelas ferramentas OpenAPI do Orchestrate.
ATLASOIL_TOOL_API_KEY=replace-with-a-long-random-value

# Alternativa explícita de desenvolvimento/demonstração.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

FINNHUB_API_KEY=
# Tickers adicionais do Yahoo Finance, por exemplo USO,BNO.
EXTRA_ASSETS=
